# =============================================================================
# SadakaPass - Переменные окружения
# =============================================================================
# Скопируйте этот файл в .env.local и заполните значениями
# Документация по API: docs/BACKEND_API_INTEGRATION.md
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (Обязательно)
# -----------------------------------------------------------------------------
# Получите в Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# -----------------------------------------------------------------------------
# BOT API (Рекомендуется)
# -----------------------------------------------------------------------------
# Основной backend для статистики, кампаний и фондов
# При отсутствии токена используется fallback на Supabase
BOT_API_BASE_URL=https://bot.e-replika.ru
BOT_API_TOKEN=ваш_токен

# -----------------------------------------------------------------------------
# ПЛАТЕЖНЫЕ СИСТЕМЫ (Обязательно для приёма платежей)
# -----------------------------------------------------------------------------

# YooKassa - для платежей в рублях
# Получите в личном кабинете YooKassa: https://yookassa.ru
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_secret_key_xxx

# CloudPayments - для международных платежей
# Получите в личном кабинете CloudPayments: https://cloudpayments.ru
NEXT_PUBLIC_CLOUDPAYMENTS_PUBLIC_ID=pk_xxx
CLOUDPAYMENTS_API_PASSWORD=xxx

# Внешний Payment API (опционально, если используется отдельный сервис)
PAYMENT_API_URL=https://api.payment-service.com
PAYMENT_API_TOKEN=payment_api_token

# -----------------------------------------------------------------------------
# FONDINSAN API (Опционально)
# -----------------------------------------------------------------------------
# API для программ фонда Инсан
FONDINSAN_API_BASE_URL=https://fondinsan.ru/api/v1
FONDINSAN_ACCESS_TOKEN=ваш_access_token

# -----------------------------------------------------------------------------
# TELEGRAM БОТ (Опционально)
# -----------------------------------------------------------------------------
# Для авторизации через Telegram и уведомлений
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_SECRET_TOKEN=random_secret_string
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername

# -----------------------------------------------------------------------------
# ПРИЛОЖЕНИЕ
# -----------------------------------------------------------------------------
# URL вашего приложения (без trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Токен для защиты внутренних API endpoints
API_AUTH_TOKEN=random_secure_token_for_api

# Режим разработки (development | production)
NODE_ENV=development

# -----------------------------------------------------------------------------
# REDIS / UPSTASH (Опционально - для rate limiting и кеширования)
# -----------------------------------------------------------------------------
# Upstash Redis (рекомендуется для serverless)
# Получите в Upstash Dashboard: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Или стандартный Redis URL (если используете собственный Redis)
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# SENTRY (Опционально - для мониторинга ошибок)
# -----------------------------------------------------------------------------
# Получите DSN в Sentry: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project
SENTRY_AUTH_TOKEN=sntrys_xxx

# -----------------------------------------------------------------------------
# EMAIL (Опционально - для отправки уведомлений)
# -----------------------------------------------------------------------------
# SMTP настройки для отправки email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=smtp_password
SMTP_FROM=SadakaPass <noreply@example.com>

# =============================================================================
# ВАЖНО: Никогда не коммитьте .env.local в репозиторий!
# =============================================================================

